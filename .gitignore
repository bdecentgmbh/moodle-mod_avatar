# Addons live in private repositories and are wired in as git submodules (see .gitmodules).
# Git only records the submodule commit here, never the addon code. Any other directory under
# addon/ is ignored so addon code can never be committed to this repository by accident.
/addon/*/
!/addon/availability/
!/addon/autoassign/
!/addon/importexport/
!/addon/popover/
!/addon/reports/
