{{!
    @template mod_avatar/avatar_activity

    The avatars of an avatar activity, on the activity page or inline on the course page.

    Context variables required for this template:
    * displaymodepage - Shown on the activity page
    * displaymodeinline - Shown on the course page
    * headercontent, footercontent, emptystate - Formatted HTML of the activity texts
    * hasavatars - Whether the activity offers avatars
    * isavailable - Whether the user may collect avatars in the activity
    * has_availability_restriction - Whether to show the availability box
    * availabilitymessages - Messages of the addons
    * avatars - The avatars, with id, name (escaped), previewimage, view_url, cmid, canpick, canupgrade,
      isavailable and progress_indicators

    Example context (json):
    {
        "displaymodepage": true,
        "headercontent": "<p>Pick an avatar that suits you.</p>",
        "hasavatars": true,
        "isavailable": true,
        "has_availability_restriction": true,
        "availabilitymessages": [{"message": "You can collect 2 more avatars in this activity."}],
        "avatars": [
            {
                "id": 1,
                "name": "Fiona",
                "previewimage": "https://example.com/fiona.png",
                "view_url": "https://example.com/mod/avatar/view_avatar.php?avatarid=1&cmid=2",
                "cmid": 2,
                "canpick": true,
                "isavailable": true,
                "progress_indicators": [{"completed": false}, {"completed": false}]
            }
        ],
        "emptystate": "",
        "footercontent": ""
    }
}}
<div class="mod_avatar{{#displaymodepage}} display-page{{/displaymodepage}}{{#displaymodeinline}} display-inline{{/displaymodeinline}}">
    {{#headercontent}}
    <div class="avatar-header mb-4">
        {{{headercontent}}}
    </div>
    {{/headercontent}}

    {{#hasavatars}}
    <div class="avatar-title-container">
        <h2 class="avatar-title">{{#str}}pickyouravatar, mod_avatar{{/str}}</h2>
        {{#has_availability_restriction}}
        <div class="alert alert-warning" role="status">
            <h3 class="h5">{{#str}}limitedavailability, mod_avatar{{/str}}</h3>
            {{#availabilitymessages}}
            <p class="mb-1">{{message}}</p>
            {{/availabilitymessages}}
            {{^isavailable}}
            <p class="mb-0">{{#str}}limitreached, mod_avatar{{/str}}</p>
            {{/isavailable}}
        </div>
        {{/has_availability_restriction}}
        <p>{{#str}}clickforavatarinfo, mod_avatar{{/str}}</p>
    </div>
    <div class="avatar-gallery">
        {{#avatars}}
        <div class="avatar-card card avatar-details" data-title="{{name}}">
            <div class="card-header">
                <a href="{{view_url}}" class="text-decoration-none">
                    <div class="avatar-image-wrapper">
                        <img src="{{previewimage}}" alt="{{name}}" class="mx-auto d-block avatar-cover">
                    </div>
                    <h3 class="card-title">{{name}}</h3>
                </a>
            </div>
            <div class="card-body">
                <div class="avatar-progress" aria-hidden="true">
                    {{#progress_indicators}}
                    <div class="progress-indicator {{#completed}}bg-success{{/completed}}{{^completed}}bg-secondary{{/completed}}"></div>
                    {{/progress_indicators}}
                </div>
            </div>
            <div class="card-footer avatar-actions">
                {{#isavailable}}
                {{#canpick}}
                <button type="button" class="btn btn-primary collect-avatar" data-avatarid="{{id}}" data-cmid="{{cmid}}">
                    {{#str}}pick, mod_avatar{{/str}}
                </button>
                {{/canpick}}
                {{#canupgrade}}
                <button type="button" class="btn btn-secondary upgrade-avatar" data-avatarid="{{id}}" data-cmid="{{cmid}}">
                    {{#str}}upgrade, mod_avatar{{/str}}
                </button>
                {{/canupgrade}}
                {{/isavailable}}
                {{^isavailable}}
                <button type="button" class="btn btn-secondary" disabled>
                    {{#str}}unavailable, mod_avatar{{/str}}
                </button>
                {{/isavailable}}
            </div>
        </div>
        {{/avatars}}
    </div>
    {{/hasavatars}}

    {{^hasavatars}}
    {{#emptystate}}
    <div class="avatar-empty-state bg-light p-4 text-center rounded">
        {{{emptystate}}}
    </div>
    {{/emptystate}}
    {{^emptystate}}
    <div class="avatar-empty-state bg-light p-4 text-center rounded">
        {{#str}}noavatarsfound, mod_avatar{{/str}}
    </div>
    {{/emptystate}}
    {{/hasavatars}}

    {{#footercontent}}
    <div class="avatar-footer mt-4">
        {{{footercontent}}}
    </div>
    {{/footercontent}}
</div>
