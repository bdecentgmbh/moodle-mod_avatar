{{!
    @template mod_avatar/avatar_info

    The page of an avatar: image, progress, tags, secret information, description and media.

    Context variables required for this template:
    * id, name (escaped), description (formatted HTML), variantimage, progress, total_variants
    * cmid - The activity the page is shown in (0 outside of activities)
    * canpick, canupgrade, isavailable, fully_upgraded
    * viewsecretinfo, secretinfo (formatted HTML)
    * imagetags, texttags - Tags with name (escaped), url and image_url
    * additional_media - Images with url, alt, index and active
    * previousavatarurl, nextavatarurl - Navigation within the activity

    Example context (json):
    {
        "id": 1,
        "name": "Fiona",
        "description": "<p>A brave explorer.</p>",
        "variantimage": "https://example.com/fiona.png",
        "progress": [{"completed": true}, {"completed": false}],
        "cmid": 2,
        "canupgrade": true,
        "isavailable": true,
        "hastexttags": true,
        "texttags": [{"name": "explorer", "url": "https://example.com/tag/index.php?tag=explorer"}],
        "viewsecretinfo": true,
        "secretinfo": "<p>Fiona's secret.</p>",
        "nextavatarurl": "https://example.com/mod/avatar/view_avatar.php?avatarid=2&cmid=2"
    }
}}
<div class="avatar-info">
    <div class="avatar-block avatar-details" data-title="{{name}}">
        <div class="avatar-info-navigation clearfix">
            {{#previousavatarurl}}
            <a class="avatar-prev" href="{{previousavatarurl}}">
                {{#pix}}t/left, core{{/pix}}{{#str}}previous{{/str}}
            </a>
            {{/previousavatarurl}}
            {{#nextavatarurl}}
            <a class="avatar-next" href="{{nextavatarurl}}">
                {{#str}}next{{/str}}{{#pix}}t/right, core{{/pix}}
            </a>
            {{/nextavatarurl}}
        </div>

        {{#cmid}}
        {{^isavailable}}
        <div class="alert alert-warning mb-4" role="status">
            <h3 class="h5">{{#str}}limitedavailability, mod_avatar{{/str}}</h3>
            <p class="mb-0">{{#str}}unavailability_message, mod_avatar{{/str}}</p>
        </div>
        {{/isavailable}}
        {{/cmid}}

        {{#fully_upgraded}}
        <div class="alert alert-success">
            {{#str}}fully_upgraded, mod_avatar{{/str}}
        </div>
        {{/fully_upgraded}}

        <div class="avatar-image">
            <img src="{{variantimage}}" alt="{{name}}" class="img-fluid">
        </div>
        <div class="avatar-progress-bar" aria-hidden="true">
            {{#progress}}
            <div class="progress-indicator {{#completed}}completed{{/completed}}"></div>
            {{/progress}}
        </div>
        <h2 class="avatar-title">{{name}}</h2>

        {{#hasimagetags}}
        <div class="avatar-image-tags mb-4">
            {{#imagetags}}
            <a href="{{url}}" class="avatar-tag-image" title="{{name}}">
                <img src="{{image_url}}" alt="{{name}}" class="rounded-circle" width="40" height="40">
            </a>
            {{/imagetags}}
        </div>
        {{/hasimagetags}}

        {{#hastexttags}}
        <div class="avatar-text-tags">
            {{#texttags}}
            <a href="{{url}}" class="badge rounded-pill bg-secondary text-dark">#{{name}}</a>
            {{/texttags}}
        </div>
        {{/hastexttags}}

        {{#cmid}}
        <div class="avatar-buttons avatar-actions">
            {{#isavailable}}
            {{#canpick}}
            <button type="button" class="btn btn-primary collect-avatar" data-avatarid="{{id}}" data-cmid="{{cmid}}">
                {{#str}}pick, mod_avatar{{/str}}
            </button>
            {{/canpick}}
            {{#canupgrade}}
            <button type="button" class="btn btn-primary upgrade-avatar" data-avatarid="{{id}}" data-cmid="{{cmid}}">
                {{#str}}upgrade, mod_avatar{{/str}}
            </button>
            {{/canupgrade}}
            {{/isavailable}}
            {{^isavailable}}
            <button type="button" class="btn btn-secondary" disabled>
                {{#str}}unavailable, mod_avatar{{/str}}
            </button>
            {{/isavailable}}
        </div>
        {{/cmid}}
    </div>

    {{#viewsecretinfo}}
    <div class="alert bg-secret">
        <h3 class="h5">{{#str}}secretunlocked, mod_avatar{{/str}}</h3>
        <div class="avatar-secret">{{{secretinfo}}}</div>
    </div>
    {{/viewsecretinfo}}

    <div class="avatar-description">
        {{{description}}}
    </div>

    {{#hasadditionalmedia}}
    <div id="avatar-media-carousel-{{uniqid}}" class="carousel slide avatar-media avatar-media-carousel" data-ride="false" data-bs-ride="false" data-interval="false" data-bs-interval="false" data-wrap="false" data-bs-wrap="false">
        <div class="carousel-inner rounded">
            {{#additional_media}}
            <div class="carousel-item{{#active}} active{{/active}}">
                <img src="{{url}}" class="d-block w-100" alt="{{alt}}">
            </div>
            {{/additional_media}}
        </div>
        {{#additional_media.1}}
        <button class="carousel-control-prev" type="button" data-target="#avatar-media-carousel-{{uniqid}}" data-bs-target="#avatar-media-carousel-{{uniqid}}" data-slide="prev" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="accesshide">{{#str}}previous{{/str}}</span>
        </button>
        <button class="carousel-control-next" type="button" data-target="#avatar-media-carousel-{{uniqid}}" data-bs-target="#avatar-media-carousel-{{uniqid}}" data-slide="next" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="accesshide">{{#str}}next{{/str}}</span>
        </button>
        {{/additional_media.1}}
    </div>
    {{/hasadditionalmedia}}
</div>
