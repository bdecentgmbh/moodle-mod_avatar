{{!
    @template mod_avatar/myavatars

    The avatar collection of the current user (My avatars).

    Context variables required for this template:
    * has_avatars - Whether the user owns avatars
    * avatars - id, name (escaped), previewimage, view_url, progress_indicators, isprimary, cmid, canupgrade,
      setprimaryurl, sesskey

    Example context (json):
    {
        "has_avatars": true,
        "avatars": [
            {
                "id": 1,
                "name": "Fiona",
                "previewimage": "https://example.com/fiona.png",
                "view_url": "https://example.com/mod/avatar/view_avatar.php?avatarid=1",
                "progress_indicators": [{"completed": true}, {"completed": false}],
                "isprimary": false,
                "cmid": 2,
                "canupgrade": true,
                "setprimaryurl": "https://example.com/mod/avatar/myavatars.php",
                "sesskey": "abc123"
            }
        ]
    }
}}
<div class="mod_avatar my-avatars">
    {{^has_avatars}}
    <div class="alert alert-info">{{#str}}noavatars, mod_avatar{{/str}}</div>
    {{/has_avatars}}

    {{#has_avatars}}
    <p class="mb-4">{{#str}}clickforavatarinfo, mod_avatar{{/str}}</p>
    <div class="avatar-gallery">
        {{#avatars}}
        <div class="gallery-block">
            <div class="avatar-card card h-100 avatar-details" data-title="{{name}}">
                <div class="card-header">
                    <a href="{{view_url}}" class="text-decoration-none">
                        <div class="avatar-image-wrapper mb-3">
                            <img src="{{previewimage}}" alt="{{name}}" class="mx-auto d-block avatar-collection-image">
                        </div>
                        <h3 class="card-title h5 text-center mb-3">{{name}}</h3>
                    </a>
                    {{#isprimary}}
                    <div class="text-center"><span class="badge rounded-pill bg-success text-white">{{#str}}primaryavatar, mod_avatar{{/str}}</span></div>
                    {{/isprimary}}
                </div>
                <div class="card-body">
                    <div class="avatar-progress" aria-hidden="true">
                        {{#progress_indicators}}
                        <div class="progress-indicator {{#completed}}bg-success{{/completed}}{{^completed}}bg-secondary{{/completed}}"></div>
                        {{/progress_indicators}}
                    </div>
                </div>
                <div class="card-footer avatar-actions">
                    {{#canupgrade}}
                    <button type="button" class="btn btn-secondary upgrade-avatar" data-avatarid="{{id}}" data-cmid="{{cmid}}">
                        {{#str}}upgrade, mod_avatar{{/str}}
                    </button>
                    {{/canupgrade}}
                    {{^isprimary}}
                    <form method="post" action="{{setprimaryurl}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="setasprimary" value="1">
                        <input type="hidden" name="avatarid" value="{{id}}">
                        <button type="submit" class="btn btn-primary set-as-profile-pic">{{#str}}setasprimary, mod_avatar{{/str}}</button>
                    </form>
                    {{/isprimary}}
                </div>
            </div>
        </div>
        {{/avatars}}
    </div>
    {{/has_avatars}}
</div>
