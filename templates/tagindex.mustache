{{!
    @template mod_avatar/tagindex

    The avatars with a tag, on the tag page.

    Context variables required for this template:
    * avatars - id, name (escaped), description (formatted HTML), viewurl

    Example context (json):
    {
        "avatars": [
            {"id": 1, "name": "Fiona", "description": "<p>A brave explorer.</p>",
             "viewurl": "https://example.com/mod/avatar/view_avatar.php?avatarid=1"}
        ]
    }
}}
{{#avatars}}
<div class="avatar-item mb-4">
    <div class="card">
        <div class="card-body">
            <h3 class="card-title h5">{{name}}</h3>
            <div class="card-text">{{{description}}}</div>
            <a href="{{viewurl}}" class="btn btn-primary">{{#str}}viewavatar, mod_avatar{{/str}}</a>
        </div>
    </div>
</div>
{{/avatars}}
{{^avatars}}
<div class="alert alert-info">
    {{#str}}noavatarsfound, mod_avatar{{/str}}
</div>
{{/avatars}}
